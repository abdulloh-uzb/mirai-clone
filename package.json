{
  "name": "roadready",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check . && tsx scripts/check-conventions.ts",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:db && pnpm test:e2e",
    "check:locked": "bash scripts/with-stack-lock.sh 'pnpm db:reset && pnpm check'",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:env": "supabase status -o env",
    "db:types": "supabase gen types typescript > src/lib/database.types.ts",
    "db:seed:course": "tsx scripts/generate-course-seed.ts",
    "db:make-admin": "tsx scripts/make-admin.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "ai:reindex": "tsx scripts/reindex-kb.ts",
    "report:run": "tsx scripts/run-report-batch.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.109",
    "@ai-sdk/react": "^4.0.187",
    "@hookform/resolvers": "^7.0.9",
    "@react-pdf/renderer": "^4.9.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "ai": "^7.0.182",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "next-intl": "4.16.2",
    "next-themes": "0.4.6",
    "posthog-js": "^1.455.2",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "stripe": "^23.2.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "supabase": "3.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "5.1.2"
  },
  "packageManager": "pnpm@10.34.5"
}
