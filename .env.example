# Copy to .env.local (gitignored) and fill in. Never commit real values.
# Local Supabase values: run `pnpm db:start`, then `pnpm db:env` and copy
# API_URL, ANON_KEY (or PUBLISHABLE_KEY) and SERVICE_ROLE_KEY (or SECRET_KEY).

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Search engines may index the site only when this is "true" (default: noindex everywhere)
SITE_INDEXABLE=

# Supabase (server-only: SUPABASE_SERVICE_ROLE_KEY must never reach the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Leave STRIPE_SECRET_KEY empty for mock payments mode: checkout goes to
# /api/stripe/mock-checkout, which fakes a paid event (404 in production unless PAYMENTS_MOCK=1).
PAYMENTS_MOCK=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email via Resend (later phase; local auth emails go to Mailpit at http://127.0.0.1:54324)
RESEND_API_KEY=
# Or any SMTP server (used when RESEND_API_KEY is empty). 465 = TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender, e.g. "RoadReady <you@example.com>". Default: noreply@ on the contact email's domain.
EMAIL_FROM=

# Tests read caught auth emails from Mailpit (local Supabase stack)
MAILPIT_URL=http://127.0.0.1:54324

# AI assistant (phase 6)
AI_API_KEY=
AI_MODEL=

# Admin course editor: "Translate with AI" (OpenAI). Blank = button shows it is off.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Protects the DMV reporting cron route (phase 5)
CRON_SECRET=

# Analytics and errors (later phase)
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=

# Browser Sentry (errors only, after analytics consent)
NEXT_PUBLIC_SENTRY_DSN=
